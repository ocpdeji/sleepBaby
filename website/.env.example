# ─────────────────────────────────────────────
# Six & Thriving — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.
# ─────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# MailerLite (Integrations → API → Generate new token)
MAILERLITE_API_KEY=your-mailerlite-api-key
# Group IDs (MailerLite → Subscribers → Groups → click group → ID in URL)
MAILERLITE_CHEATSHEET_GROUP_ID=your-cheatsheet-group-id
MAILERLITE_WEBSITE_GROUP_ID=your-website-group-id

# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=sixandthriving.com

# Public site URL (used for SEO canonical + sitemap)
NEXT_PUBLIC_SITE_URL=https://www.sixandthriving.com
