# Copy this file to .env (no extension prefix) and fill in your real values.
# .env should be added to .gitignore — never commit your API key.

# ──────────────────────────────────────────────────────────
# MailerLite API key
# Get yours at: https://dashboard.mailerlite.com/integrations/api
# Account → Integrations → MailerLite API → Generate new token
# ──────────────────────────────────────────────────────────
MAILERLITE_API_KEY=your_api_key_here

# Your sending email (must be on a verified domain in MailerLite)
FROM_EMAIL=hello@sixandthriving.com
FROM_NAME=Six & Thriving

# Where moms will buy products
BUY_BOOK_URL=https://payhip.com/b/m62Yx
BUY_BUNDLE_URL=https://payhip.com/b/zH6ib
BUY_TODDLER_URL=https://payhip.com/b/CgT2K
BUY_NEWBORN_URL=https://payhip.com/b/Me6L9

# Where moms can re-download the cheat sheet (your hosting URL)
CHEAT_SHEET_URL=https://www.sixandthriving.com/downloads/cheat-sheet
